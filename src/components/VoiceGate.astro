---
// Entry screen, once per session on any page. Hidden unless the inline head script
// adds `gate-on` to <html>, so with JS off the page renders directly.
---
<div id="gate" role="dialog" aria-modal="true" aria-label="Enter the portfolio">
  <div class="gate-inner">
    <button id="gate-key" class="key" type="button" aria-pressed="false" aria-label="fn: tap, then say “Let’s go”">
      <span class="key-fn">fn</span>
      <svg class="key-globe" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
        <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8" />
        <ellipse cx="12" cy="12" rx="4" ry="9" fill="none" stroke="currentColor" stroke-width="1.8" />
        <path d="M3 12h18M5 7h14M5 17h14" fill="none" stroke="currentColor" stroke-width="1.8" />
      </svg>
    </button>
    <p class="gate-say">Tap <span class="kbd">fn</span>, say <em>“Let’s go.”</em></p>
    <form id="gate-form" class="field" autocomplete="off">
      <label class="sr-only" for="gate-field">Or type “Let’s go”</label>
      <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
      <input id="gate-field" name="phrase" type="text" enterkeyhint="go" spellcheck="false" autocapitalize="off" placeholder="…or type it here" />
      <button class="go" type="submit" aria-label="Enter">↵</button>
    </form>
    <p id="gate-status" class="gate-status" aria-live="polite"></p>
    <p id="gate-mic" class="gate-mic" hidden></p>
  </div>
  <button id="gate-skip" class="gate-skip" type="button" data-wave>skip</button>
  <div class="ink" aria-hidden="true"><span>Let’s go.</span></div>
</div>

<style>
  #gate { display: none; }
  :global(html.gate-on) #gate {
    display: grid; place-items: center; position: fixed; inset: 0; z-index: 100;
    background: var(--cream); padding: 24px 16px;
  }
  :global(html.gate-on) body { overflow: hidden; }
  :global(html.gate-on .site) { visibility: hidden; }

  .gate-inner { text-align: center; }
  .key {
    position: relative; width: 148px; height: 148px; margin: 0 auto; display: block;
    border-radius: 24px; border: var(--bw) solid var(--ink); cursor: pointer; color: var(--ink);
    background: var(--lilac); box-shadow: var(--shadow-hard);
    transition: transform 0.2s, box-shadow 0.2s, background-color 0.3s;
    touch-action: none; -webkit-user-select: none; user-select: none; -webkit-touch-callout: none;
  }
  .key-fn { position: absolute; top: 16px; right: 20px; font: 600 1.45rem/1 var(--sans); }
  .key-globe { position: absolute; bottom: 18px; left: 20px; width: 26px; height: 26px; }
  :global(#gate.listening) .key {
    transform: translate(2px, 2px); box-shadow: none; background: var(--blush);
    outline: 2px solid var(--ink); outline-offset: 6px;
  }

  .gate-say { margin: 2rem 0 0; font: 400 clamp(2rem, 1.4rem + 2.6vw, 3rem)/1.05 var(--serif); letter-spacing: -0.03em; }
  .gate-say em { color: var(--ink); font-style: italic; }
  .kbd { display: inline-block; padding: 0.05em 0.3em 0.1em; border: var(--bw) solid var(--ink); border-radius: 0.25em; background: var(--lilac); font: 600 0.55em/1.2 var(--sans); vertical-align: 0.3em; letter-spacing: 0; }

  /* Flow-style text box: the transcript types out here; also a real input. */
  .field {
    display: flex; align-items: center; gap: 0.6rem; width: min(22rem, 100%); margin: 1.5rem auto 0;
    padding: 0.35rem 0.35rem 0.35rem 1rem; border: var(--bw) solid var(--ink); border-radius: 999px; background: var(--cream-2);
    transition: box-shadow 0.2s;
  }
  .field:focus-within { box-shadow: var(--shadow-hard); }
  .field input {
    flex: 1; min-width: 0; border: 0; background: none; outline: none; padding: 0.5rem 0;
    font: 400 1rem/1.2 var(--sans); color: var(--ink);
  }
  .field input::placeholder { color: var(--ink-soft); }
  .go {
    flex: none; width: 40px; height: 40px; border-radius: 999px; border: 0; cursor: pointer;
    background: var(--ink); color: var(--cream); font: 600 1.1rem/1 var(--sans);
  }
  .bars { display: none; align-items: center; gap: 3px; height: 18px; flex: none; }
  .bars i { display: block; width: 3px; height: 100%; border-radius: 2px; background: var(--ink); transform: scaleY(0.3); animation: bar 0.9s ease-in-out infinite; }
  .bars i:nth-child(2) { animation-delay: 0.15s; } .bars i:nth-child(3) { animation-delay: 0.3s; }
  .bars i:nth-child(4) { animation-delay: 0.45s; } .bars i:nth-child(5) { animation-delay: 0.6s; }
  @keyframes bar { 50% { transform: scaleY(1); } }
  :global(#gate.listening) .bars { display: inline-flex; }
  :global(#gate.listening) .field { box-shadow: var(--shadow-hard); background: var(--cream); }

  .gate-status { min-height: 1.5em; margin: 0.8rem 0 0; color: var(--ink-soft); font-size: 0.95rem; }

  .gate-mic { max-width: 22rem; margin: 0.25rem auto 0; font-size: 0.8125rem; line-height: 1.4; color: var(--ink-soft); }
  .gate-mic::before { content: ''; display: inline-block; width: 0.5rem; height: 0.5rem; margin-right: 0.45rem; border-radius: 50%; background: var(--accent); vertical-align: 0.05em; }
  .gate-skip {
    position: absolute; bottom: max(20px, env(safe-area-inset-bottom)); left: 50%; transform: translateX(-50%);
    background: none; border: 0; padding: 0 1rem; min-height: 44px; cursor: pointer;
    color: var(--ink-soft); font: 500 0.875rem/1 var(--sans); letter-spacing: 0.03em;
    transition: color 0.2s ease;
  }
  .gate-skip:hover, .gate-skip:focus-visible { color: var(--ink); }

  .ink {
    position: fixed; inset: 0; display: grid; place-items: center; pointer-events: none;
    background: var(--ink); color: var(--cream);
    clip-path: circle(0px at var(--x, 50%) var(--y, 50%));
    transition: clip-path 900ms var(--ease-out);
  }
  .ink span { font: italic 400 clamp(3rem, 8vw, 5rem)/1 var(--serif); letter-spacing: -0.03em; opacity: 0; transition: opacity 300ms ease 500ms; }
  :global(#gate.filling) .ink { clip-path: circle(150vmax at var(--x, 50%) var(--y, 50%)); }
  :global(#gate.filling) .ink span { opacity: 1; }
  :global(#gate.leaving) { opacity: 0; transition: opacity 450ms ease; }

  /* Short screens (phones in landscape): smaller key, and skip sits in the flow, not over the status. */
  @media (max-height: 560px) {
    :global(html.gate-on) #gate { align-content: center; gap: 0.25rem; padding-block: 12px; }
    .key { width: 96px; height: 96px; border-radius: 18px; }
    .key-fn { top: 10px; right: 13px; font-size: 1.1rem; }
    .key-globe { bottom: 11px; left: 13px; width: 20px; height: 20px; }
    .gate-say { margin-top: 1rem; font-size: 1.75rem; }
    .field { margin-top: 0.9rem; }
    .gate-status { margin-top: 0.4rem; }
    .gate-mic { margin-top: 0; }
    .gate-skip { position: static; transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .key, .ink, .ink span { transition: none; }
    .bars i { animation: none; transform: scaleY(0.7); }
    :global(#gate.leaving) { transition: opacity 150ms linear; }
  }
</style>

<script>
  import '../scripts/voice-gate.ts';
</script>
