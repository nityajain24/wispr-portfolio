---
import Layout from '../layouts/Layout.astro';
import { url } from '../data/url';
---
<Layout title="About" description="Nitya Jain: who I am and how I work." current="about">
  <header class="wrap head">
    <p class="eyebrow">About</p>
    <h1 tabindex="-1">The <em>short</em> version</h1>
  </header>
  <div class="wrap">
    <div class="cols">
    <ol class="tl">
      <li><span>Jul 2025 – now</span><div><strong>HyperVerge</strong>, Associate Product Manager. Financial onboarding: getting clients from UAT to production, and analysing funnels, failures and latency. Product intern there from January 2025.</div></li>
      <li><span>2024</span><div><strong>CASHe</strong>, product intern: lending journeys, Account Aggregator adoption, an EV-financing partnership. <strong>Dualite</strong>, product intern: usage and pricing analysis in Mixpanel.</div></li>
      <li><span>Dec 2022 – Jan 2024</span><div><strong>Mystic Labs</strong>, founding team, Head of Product. <a href={url('work/mystic/')}>ChaturGPT and Bloc</a>.</div></li>
      <li><span>2021 – 2025</span><div><strong>MIT Manipal</strong>, B.Tech in Electronics and Communication. Also Team Karting Manipal.</div></li>
      <li><span>2021</span><div><a href={url('work/ghy/')}><strong>Ghy Fights Covid</strong></a>, Guwahati.</div></li>
    </ol>

    <figure class="photo">
      <img src={url('img/karting.jpg')} alt="Team Karting Manipal members in team shirts, grouped behind their go-kart at an outdoor event" width="1024" height="682" loading="lazy" />
      <figcaption>Team Karting Manipal, at college.</figcaption>
    </figure>
    </div>

    <p class="human">Outside work: drums, running and personal finance.</p>
  </div>
</Layout>

<style>
  .cols { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0 3rem; align-items: start; }
  @media (min-width: 992px) {
    .cols { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); }
    .photo { position: sticky; top: 7rem; margin-top: 1rem; }
    .tl { margin-bottom: 0; }
  }
  .tl { list-style: none; padding: 0; margin: 0 0 3rem; max-width: 50rem; }
  .tl li { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.2rem; padding: 1rem 0; border-top: var(--bw) solid var(--line); }
  @media (min-width: 720px) { .tl li { grid-template-columns: 10rem minmax(0, 1fr); column-gap: 1.5rem; } }
  .tl span { color: var(--ink-soft); font: 400 1.25rem/1.4 var(--serif); font-variant-numeric: tabular-nums; }
  .photo { margin: 0; max-width: 44rem; }
  .photo img { width: 100%; border: var(--bw) solid var(--ink); border-radius: var(--r-section); display: block; }
  .photo figcaption { font-size: 0.875rem; color: var(--ink-soft); margin-top: 0.5rem; }
  .human { margin-top: 2.5rem; font: 400 var(--fs-h4)/1.3 var(--serif); letter-spacing: -0.03em; }
</style>
